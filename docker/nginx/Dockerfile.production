FROM node:24-alpine AS assets

WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY resources ./resources
COPY public ./public
COPY vite.config.js ./
RUN npm run build

FROM nginx:1.28-alpine

ARG APP_VERSION

LABEL org.opencontainers.image.title="DNS Center Web" \
      org.opencontainers.image.version="${APP_VERSION}"

COPY docker/nginx/templates/default.conf.template /etc/nginx/templates/default.conf.template
COPY public /var/www/html/public
COPY --from=assets /build/public/build /var/www/html/public/build

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD wget --no-check-certificate --spider --quiet https://127.0.0.1/up || exit 1
