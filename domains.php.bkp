<script>

setTimeout(function() {

    alert("Sessão expirada!");

    window.location.href = "logout.php";

}, 900000);

setTimeout(function() {

    let el = document.getElementById("alertaErro");

    if(el){

        el.style.transition = "opacity 0.5s";

        el.style.opacity = "0";

        setTimeout(function(){

            el.remove();

        }, 500);
    }

}, 3000);
</script>
