[Unit]
Description=Operação BIND autorizada do DNS Center Agent
After=network-online.target dns-center-agent.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment=DNS_CENTER_AGENT_ALLOW_APPLY=1
ExecStart=/usr/local/sbin/dns-center-agent --run-authorized-operation
PrivateTmp=true
ProtectHome=true
UMask=0027
