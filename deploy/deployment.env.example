# Copie para /etc/dns-center/deployment.env com modo 0600.
# Use tags imutáveis; "latest" é recusado pelo comando de deploy.
DNS_CENTER_VERSION=2026.07.30-1
DNS_CENTER_APP_IMAGE=registry.example.com/dns-center/app
DNS_CENTER_WEB_IMAGE=registry.example.com/dns-center/web

# Segredos Laravel/PostgreSQL ficam em outro arquivo, fora do repositório.
DNS_CENTER_ENV_FILE=/etc/dns-center/app.env
DNS_CENTER_CERTBOT_WWW=/var/lib/dns-center/certbot/www
DNS_CENTER_CERTBOT_CONF=/var/lib/dns-center/certbot/conf
DNS_CENTER_BACKUP_DIR=/var/backups/dns-center
DNS_CENTER_STATE_DIR=/var/lib/dns-center-deploy

DNS_CENTER_HTTP_PORT=80
DNS_CENTER_HTTPS_PORT=443

# Backup agendado (opcional). Ver docs/BACKUP_RESTORE.md.
DNS_CENTER_BACKUP_RETENTION_DAYS=14
# Cópia fora do servidor (Cloudflare R2). Ambos com modo 0600; sem a senha nada é enviado.
DNS_CENTER_BACKUP_REMOTE_ENV=/etc/dns-center/backup-r2.env
DNS_CENTER_BACKUP_PASSPHRASE_FILE=/etc/dns-center/backup.pass
