#!/usr/bin/env bash
set -euo pipefail
umask 077

PROJECT_DIR="${DNS_CENTER_PROJECT_DIR:-/opt/dns-center}"
DEPLOY_CONFIG="${DNS_CENTER_DEPLOY_CONFIG:-/etc/dns-center/deployment.env}"
COMPOSE_FILE="${PROJECT_DIR}/compose.production.yaml"

[ -r "${DEPLOY_CONFIG}" ] || exit 1
# shellcheck disable=SC1090
source "${DEPLOY_CONFIG}"
: "${DNS_CENTER_STATE_DIR:?}"
[ -r "${DNS_CENTER_STATE_DIR}/current-version" ] || exit 1
DNS_CENTER_VERSION="$(<"${DNS_CENTER_STATE_DIR}/current-version")"
export DNS_CENTER_VERSION DNS_CENTER_APP_IMAGE DNS_CENTER_WEB_IMAGE DNS_CENTER_ENV_FILE
export DNS_CENTER_CERTBOT_WWW DNS_CENTER_CERTBOT_CONF DNS_CENTER_BACKUP_DIR DNS_CENTER_STATE_DIR

compose=(docker compose --project-directory "${PROJECT_DIR}" --env-file "${DEPLOY_CONFIG}" -f "${COMPOSE_FILE}")
raw="$("${compose[@]}" exec -T app php artisan dns-center:agent-firewall-export --no-ansi)"
v4=""
v6=""
while IFS= read -r ip; do
    [ -n "${ip}" ] || continue
    if [[ "${ip}" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        v4+="${v4:+, }${ip}"
    elif [[ "${ip}" =~ ^[0-9A-Fa-f:]+$ && "${ip}" == *:* ]]; then
        v6+="${v6:+, }${ip}"
    else
        printf 'IP inválido recusado: %s\n' "${ip}" >&2; exit 1
    fi
done <<< "${raw}"

rules="$(mktemp)"; trap 'rm -f "${rules}"' EXIT
{
    printf 'table inet dns_center_agent_guard {\n'
    printf ' set blocked_v4 { type ipv4_addr; flags interval;'
    [ -z "${v4}" ] || printf ' elements = { %s };' "${v4}"
    printf ' }\n'
    printf ' set blocked_v6 { type ipv6_addr; flags interval;'
    [ -z "${v6}" ] || printf ' elements = { %s };' "${v6}"
    printf ' }\n'
    printf ' chain input { type filter hook input priority -5; policy accept; tcp dport { %s, %s } ip saddr @blocked_v4 drop; tcp dport { %s, %s } ip6 saddr @blocked_v6 drop; }\n' "${DNS_CENTER_HTTP_PORT:-80}" "${DNS_CENTER_HTTPS_PORT:-443}" "${DNS_CENTER_HTTP_PORT:-80}" "${DNS_CENTER_HTTPS_PORT:-443}"
    printf '}\n'
} > "${rules}"

nft list table inet dns_center_agent_guard >/dev/null 2>&1 && nft delete table inet dns_center_agent_guard
nft -f "${rules}"
"${compose[@]}" exec -T app php artisan dns-center:agent-firewall-confirm --no-ansi >/dev/null
