<?php
date_default_timezone_set('America/Sao_Paulo');
require "config.php";
require "includes/logs.php";
require "includes/security.php";
if (session_status() !== PHP_SESSION_ACTIVE) {
    session_start();
}

// verifica se está logado
if (!isset($_SESSION['logado'])) {
    header("Location: login.php");
    exit;
}

// controle de tempo de sessão
if (isset($_SESSION['ultimo_acesso'])) {

    $tempo_inativo = time() - $_SESSION['ultimo_acesso'];

    if ($tempo_inativo > $session_timeout) {
        session_destroy();
        header("Location: login.php?timeout=1");
        exit;
    }
}

// atualiza tempo de atividade
$_SESSION['ultimo_acesso'] = time();

if (!isset($_SESSION['logado'])) {
    header("Location: login.php");
    exit;
}

if (!$domains) {
    header("Location: domains.php");
    exit;
}

$domain = strtolower(trim($_GET['domain'] ?? array_key_first($domains)));
if (!isset($domains[$domain])) {
    http_response_code(404);
    exit("Domínio não encontrado.");
}
$file = $domains[$domain];


$ipv6_file = "/var/cache/bind/master-rev/{$domain}.rev6";
function is_valid_ip($ip, $type) {
    if ($type == "A") return filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV4);
    if ($type == "AAAA") return filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6);
    return true;
}

function record_exists($file, $name, $type, $value) {

    $name  = strtolower(trim($name));
    $type  = strtoupper(trim($type));
    $value = strtolower(trim($value));

    foreach (file($file) as $line) {

        $cmp = strtolower(preg_replace('/\s+/', ' ', trim($line)));
        $target = strtolower("$name IN $type $value");

        if ($cmp === $target) {
            return true;
        }
    }

    return false;
}

function get_records($file) {

    $records = [];

    $lines = file($file);

    foreach ($lines as $idx => $line) {

        if (preg_match('/^(\S+)\s+IN\s+(A|AAAA|CNAME|TXT)\s+(.+)$/', trim($line), $m)) {

            $records[] = [
                'line_id' => $idx,
                'raw'     => $line,
                'name'    => $m[1],
                'type'    => $m[2],
                'value'   => $m[3]
            ];
        }
    }

    return $records;
}

function get_ptr_v6($file) {
    $records = [];
    foreach (file($file) as $line) {
        if (preg_match('/^([0-9a-f\.]+)\s+IN\s+PTR\s+(.+)$/i', trim($line), $m)) {
            $records[] = ['raw'=>trim($line),'ptr'=>$m[1],'host'=>$m[2]];
        }
    }
    return $records;
}

function ipv6_to_ptr_full($ipv6) {
    $bin = inet_pton($ipv6);
    if ($bin === false) return false;

    $hex = unpack("H*", $bin)[1];
    return implode('.', array_reverse(str_split($hex)));
}

function ptr_ipv6_exists($file, $ipv6) {
    $zoneName = bind_zone_name_for_file($file);
    $ptr = $zoneName ? ipv6_ptr_owner($ipv6, $zoneName) : null;
    if ($ptr === null) return false;

    foreach (file($file) as $line) {
        $line = trim($line);
        if (stripos($line, $ptr . " IN PTR") === 0) {
            return true;
        }
    }
    return false;
}

function update_serial($file) {
    $lines = file($file);
    foreach ($lines as $i=>$line) {
        if (strpos($line,'serial') !== false) {
            preg_match('/\d+/',$line,$m);
            $cur = $m[0] ?? date('Ymd00');
            $today = date('Ymd');
            $num = substr($cur,8,2);
            $new = (substr($cur,0,8)==$today)
                ? $today . str_pad($num+1,2,'0',STR_PAD_LEFT)
                : $today."01";
            $lines[$i] = preg_replace('/\d+/',$new,$line);
            break;
        }
    }
    file_put_contents($file, implode("",$lines));
}

$erro = null;
$sucesso = null;

# ADD
# CREATE DOMAIN

if (isset($_POST['add'])) {
    require_csrf();

    $name  = trim($_POST['name'] ?? '');
    $type  = strtoupper(trim($_POST['type'] ?? ''));
    $value = trim($_POST['value'] ?? '');

    if (!valid_hostname($name) || str_contains($value, "\n") || str_contains($value, "\r")) {
        $erro = "Nome ou valor inválido!";
    }

    elseif ($type == "PTRV6") {

        if (!filter_var($name, FILTER_VALIDATE_IP, FILTER_FLAG_IPV6)) {
            $erro = "IPv6 inválido!";
        }
        elseif (!is_file($ipv6_file)) {
            $erro = "Zona reversa IPv6 não encontrada!";
        }
        elseif (!valid_hostname($value)) {
            $erro = "Hostname inválido!";
        }
        elseif (ptr_ipv6_exists($ipv6_file, $name)) {
            $erro = "Já existe PTR para esse IPv6!";
        }
        else {
            $bindZone = bind_zone_name_for_file($ipv6_file);
            $ptr = $bindZone ? ipv6_ptr_owner($name, $bindZone) : null;

           if ($ptr === null) {
               $erro = "O IPv6 não pertence ao prefixo desta zona.";
           } elseif (!str_contains($value, '.')) {

    $host = $value . "." . $domain . ".";

} else {

    $host = rtrim($value, '.') . '.';
}

            if (!$erro) {
                $content = rtrim(file_get_contents($ipv6_file)) . "\n$ptr IN PTR $host\n";
                $content = increment_zone_serial($content);

                if (!validate_zone_content($bindZone, $content, $validationError)) {
                    $erro = "Erro na zona reversa: " . $validationError;
                } elseif (!write_file_safely($ipv6_file, $content)) {
                    $erro = "Não foi possível gravar a zona reversa.";
                } else {
                    reload_dns();
                    dns_log("ADD", "PTRv6", $name, $host, $domain);
                    $sucesso = "PTR IPv6 adicionado com sucesso!";
                }
            }
        }

    } else {

        if (!in_array($type, ['A', 'AAAA', 'CNAME', 'TXT'], true)) {
            $erro = "Tipo de registro inválido!";
        }
        elseif (!is_valid_ip($value,$type)) {
            $erro="IP inválido!";
        }
        elseif ($type === 'CNAME' && !valid_hostname($value)) {
            $erro = "CNAME inválido!";
        }
        elseif ($type === 'TXT' && !preg_match('/^".*"$/s', $value)) {
            $erro = "TXT deve estar entre aspas!";
        }
        elseif (record_exists($file,$name,$type,$value)) {
            $erro="Registro já existe!";
        }
        else {

            $record = sprintf("%-20s IN %-6s %s\n", $name, $type, $value);
            $content = increment_zone_serial(rtrim(file_get_contents($file)) . "\n" . $record);

            if (!validate_zone_content($domain, $content, $validationError)) {
                $erro = "Erro na zona DNS: " . $validationError;
            } elseif (!write_file_safely($file, $content)) {
                $erro = "Não foi possível gravar a zona.";
            } else {
                reload_dns();
                dns_log("ADD", $type, $name, $value, $domain);
                $sucesso = "Registro adicionado com sucesso!";
            }
        }
    }
}


# DELETE PTR
if (isset($_POST['delete_ptr'])) {
    require_csrf();
    $target = trim($_POST['ptr_raw']);
    $new=[];
if ($ipv6_file && file_exists($ipv6_file)) {

    foreach (file($ipv6_file) as $l) {

        if (trim($l) !== $target)
            $new[] = $l;
    }

}
    $content = increment_zone_serial(implode("", $new));
    $bindZone = bind_zone_name_for_file($ipv6_file);
    if ($bindZone && validate_zone_content($bindZone, $content, $validationError) &&
        write_file_safely($ipv6_file, $content)) {
        reload_dns();
        dns_log("DELETE", "PTRv6", $target, "-", $domain);
        $sucesso = "PTR removido com sucesso!";
    } else {
        $erro = "Não foi possível remover o PTR.";
    }
}
# DELETE NORMAL
if (isset($_POST['delete'])) {
    require_csrf();

    $target = trim($_POST['raw']);

    $lines = file($file);

    $new = [];

    foreach ($lines as $l) {

        if (trim($l) != $target) {
            $new[] = $l;
        }
    }

       $content = increment_zone_serial(implode("", $new));
       if (validate_zone_content($domain, $content, $validationError) &&
           write_file_safely($file, $content)) {
           reload_dns();
           dns_log("DELETE", "RECORD", $target, "-", $domain);
           header("Location: ?domain=" . urlencode($domain));
           exit;
       }
       $erro = "Não foi possível remover o registro.";

}

$records = get_records($file);

$ptrv6_records = [];

if ($ipv6_file && file_exists($ipv6_file)) {
    $ptrv6_records = get_ptr_v6($ipv6_file);
}
