$content = file($file);
$records = [];

foreach ($content as $line) {

    $line = trim($line);

    if (
        $line == "" ||
        str_starts_with($line, ";") ||
        str_starts_with($line, "$")
    ) {
        continue;
    }

    if (
        preg_match(
            '/^(.+?)\s+IN\s+PTR\s+(.+)$/',
            $line,
            $m
        )
    ) {

        $records[] = [
            'ptr'  => $m[1],
            'host' => $m[2]
        ];
    }
}

