function ipv6_to_ptr_full($ipv6) {
    $bin = inet_pton($ipv6);

    if ($bin === false)
        return false;

    $hex = unpack("H*", $bin)[1];

    return implode(
        '.',
        array_reverse(
            str_split($hex)
        )
    );
}

function ptr_ipv6_exists($file, $ipv6) {

    $ptr = ipv6_to_ptr_full($ipv6);

    $ptr = preg_replace(
        '/(\.c\.b\.2\.5\.4\.0\.8\.2)+$/',
        '',
        $ptr
    );

    foreach (file($file) as $line) {

        $line = trim($line);

        if (
            stripos(
                $line,
                $ptr . " IN PTR"
            ) === 0
        ) {
            return true;
        }
    }

    return false;
}

function atualizarSerial($file)
{
    $content = file_get_contents($file);

    if (preg_match('/^\s*(\d{10})\s*$/m', $content, $match)) {

        $serialAntigo = $match[1];
        $serialNovo = $serialAntigo + 1;

        $content = preg_replace(
            '/^\s*' . preg_quote($serialAntigo, '/') . '\s*$/m',
            $serialNovo,
            $content,
            1
        );

        file_put_contents($file, $content);
    }
}


